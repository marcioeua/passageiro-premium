---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Página não encontrada">
  <section class="container nf">
    <p class="code">404</p>
    <h1>Ops! Esse voo foi cancelado.</h1>
    <p>A página que você procura não existe ou mudou de endereço.</p>
    <a href="/" class="btn">Voltar ao início</a>
  </section>
</BaseLayout>
<style>
  .nf { text-align: center; padding: 100px 20px; }
  .code { font-family: var(--font-head); font-size: 6rem; color: var(--c-accent); margin: 0; line-height: 1; }
</style>

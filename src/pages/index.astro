---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Sidebar from '../components/Sidebar.astro';
import AdSlot from '../components/AdSlot.astro';
import { CATEGORIES } from '../consts';
import { getPosts } from '../utils';

const posts = await getPosts();
const [featured, ...rest] = posts;
---
<BaseLayout>
  <section class="hero">
    <div class="container hero-inner">
      <span class="badge">Blog de viagens</span>
      <h1>Viaje Como <span>Premium</span>,<br />Pague Como Econômica.</h1>
      <p>Estratégias de milhas, salas VIP, upgrades e roteiros para você viajar com conforto gastando menos.</p>
      <div class="hero-actions">
        <a href="/blog" class="btn">Ver artigos</a>
        <a href="/categoria/milhas" class="btn btn-ghost">Guia de milhas</a>
      </div>
    </div>
  </section>

  <section class="container cat-strip">
    {Object.entries(CATEGORIES).map(([slug, name]) => (
      <a href={`/categoria/${slug}`} class="cat-pill">{name}</a>
    ))}
  </section>

  <div class="container layout-sidebar">
    <div>
      {featured && (
        <>
          <h2 class="section-title">Destaque</h2>
          <a href={`/blog/${featured.id}`} class="featured">
            {featured.data.heroImage && <img src={featured.data.heroImage} alt="" width="1200" height="600" />}
            <div class="f-text">
              <span class="badge">{CATEGORIES[featured.data.category]}</span>
              <h3>{featured.data.title}</h3>
              <p>{featured.data.description}</p>
            </div>
          </a>
        </>
      )}

      <AdSlot slot="" />

      <h2 class="section-title">Últimos artigos</h2>
      <div class="posts-grid">
        {rest.slice(0, 6).map((post) => <PostCard post={post} />)}
      </div>
      <p class="more"><a href="/blog" class="btn">Todos os artigos →</a></p>
    </div>
    <Sidebar />
  </div>
</BaseLayout>

<style>
  .hero {
    background:
      linear-gradient(110deg, rgba(15,42,74,.95) 30%, rgba(15,42,74,.55)),
      url('https://images.unsplash.com/photo-1436491865332-7a61a109cc05?w=1800&q=80&auto=format&fit=crop') center/cover,
      var(--c-primary);
    color: #fff; padding: 110px 0 120px;
  }
  .hero-inner { max-width: var(--container); }
  .hero h1 { color: #fff; font-size: clamp(2.2rem, 5.5vw, 3.6rem); margin: .4em 0; max-width: 720px; }
  .hero h1 span { color: var(--c-accent); }
  .hero p { font-size: 1.15rem; color: #e2e8f0; max-width: 560px; }
  .hero .badge { background: rgba(255,255,255,.12); color: var(--c-accent); }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 28px; }
  .btn-ghost { background: transparent; color: #fff; box-shadow: inset 0 0 0 2px rgba(255,255,255,.5); }
  .btn-ghost:hover { background: #fff; color: var(--c-primary); }

  .cat-strip { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: -26px; position: relative; }
  .cat-pill {
    background: #fff; padding: .75em 1.6em; border-radius: 999px; box-shadow: var(--shadow);
    font-weight: 600; color: var(--c-primary); font-size: .92rem;
  }
  .cat-pill:hover { background: var(--c-accent); color: var(--c-primary); }

  .featured {
    position: relative; display: block; border-radius: var(--radius); overflow: hidden;
    box-shadow: var(--shadow); aspect-ratio: 2/1; background: var(--c-primary); min-height: 300px;
  }
  .featured img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
  .featured:hover img { transform: scale(1.04); }
  .f-text {
    position: absolute; inset: auto 0 0 0; padding: 32px;
    background: linear-gradient(transparent, rgba(15,42,74,.95));
  }
  .f-text h3 { color: #fff; font-size: clamp(1.3rem, 3vw, 1.9rem); margin: .4em 0 .3em; }
  .f-text p { color: #e2e8f0; margin: 0; }
  .f-text .badge { background: var(--c-accent); color: var(--c-primary); }
  .more { text-align: center; margin-top: 36px; }
</style>

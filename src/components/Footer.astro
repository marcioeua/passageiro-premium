---
import { SITE_TITLE, SITE_DESCRIPTION, CATEGORIES } from '../consts';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container cols">
    <div>
      <p class="f-logo">Passageiro <strong>Premium</strong></p>
      <p>{SITE_DESCRIPTION}</p>
    </div>
    <div>
      <h4>Categorias</h4>
      <ul>
        {Object.entries(CATEGORIES).map(([slug, name]) => (
          <li><a href={`/categoria/${slug}`}>{name}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h4>Institucional</h4>
      <ul>
        <li><a href="/sobre">Sobre nós</a></li>
        <li><a href="/contato">Contato</a></li>
        <li><a href="/politica-de-privacidade">Política de Privacidade</a></li>
        <li><a href="/termos-de-uso">Termos de Uso</a></li>
      </ul>
    </div>
  </div>
  <div class="copy">
    <div class="container">© {year} {SITE_TITLE}. Todos os direitos reservados.</div>
  </div>
</footer>

<style>
  .site-footer { background: var(--c-primary); color: #a0aec0; margin-top: 40px; font-size: .95rem; }
  .cols { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 40px; padding: 56px 20px; }
  @media (max-width: 760px) { .cols { grid-template-columns: 1fr; gap: 24px; } }
  .f-logo { font-family: var(--font-head); font-size: 1.3rem; color: #fff; margin: 0 0 .5em; }
  .f-logo strong { color: var(--c-accent); }
  h4 { color: #fff; margin: 0 0 .8em; font-size: 1rem; }
  ul { list-style: none; padding: 0; margin: 0; }
  li { margin-bottom: .45em; }
  a { color: #cbd5e0; }
  a:hover { color: var(--c-accent); }
  .copy { border-top: 1px solid rgba(255,255,255,.08); padding: 18px 0; font-size: .85rem; text-align: center; }
</style>
